      "short": "En",
      "topics": [
        {
          "id": "simple-past",
          "name": "Simple Past",
          "summary": "Über abgeschlossene Ereignisse in der Vergangenheit sprechen.",
          "theory": [
            {
              "type": "p",
              "text": "Das **Simple Past** verwendest du für Handlungen, die in der Vergangenheit abgeschlossen sind."
            },
            {
              "type": "note",
              "text": "Signalwörter: yesterday, last week, two days ago, in 2020"
            },
            {
              "type": "h",
              "text": "Regelmäßige Verben"
            },
            {
              "type": "p",
              "text": "Du hängst **-ed** an die Grundform."
            },
            {
              "type": "example",
              "steps": [
                "play → played",
                "watch → watched",
                "live → lived"
              ]
            },
            {
              "type": "h",
              "text": "Unregelmäßige Verben"
            },
            {
              "type": "p",
              "text": "Viele häufige Verben haben eine eigene Form, die du auswendig lernen musst."
            },
            {
              "type": "list",
              "items": [
                "go → **went**",
                "see → **saw**",
                "have → **had**",
                "buy → **bought**",
                "take → **took**"
              ]
            },
            {
              "type": "h",
              "text": "Verneinung und Fragen"
            },
            {
              "type": "formula",
              "text": "did not (didn't) + Grundform"
            },
            {
              "type": "example",
              "steps": [
                "I **didn't go** to school.",
                "**Did** you **see** the film?"
              ]
            },
            {
              "type": "note",
              "text": "Nach did steht immer die Grundform. Did you went ist falsch, richtig ist Did you go."
            }
          ],
          "tasks": [
            {
              "id": "luecken-1",
              "type": "gap",
              "prompt": "Ergänze die Sätze im Simple Past.",
              "text": "Yesterday I [went] to the cinema and [saw] a great film.",
              "distractors": [
                "go",
                "seen",
                "goed"
              ],
              "explain": "go und see sind unregelmäßig: go → went, see → saw."
            },
            {
              "id": "verben-1",
              "type": "match",
              "prompt": "Ordne jedem Verb seine Simple-Past-Form zu.",
              "pairs": [
                [
                  "go",
                  "went"
                ],
                [
                  "buy",
                  "bought"
                ],
                [
                  "have",
                  "had"
                ],
                [
                  "take",
                  "took"
                ]
              ],
              "explain": "Diese vier Verben sind unregelmäßig und kommen sehr häufig vor."
            },
            {
              "id": "watch-1",
              "type": "input",
              "prompt": "Setze das Verb ins Simple Past: She (watch) TV last night.",
              "answer": "watched",
              "numeric": false,
              "hint": "watch ist ein regelmäßiges Verb.",
              "explain": "Regelmäßig: watch + ed = watched."
            },
            {
              "id": "satz-1",
              "type": "order",
              "prompt": "Bringe die Wörter in die richtige Reihenfolge.",
              "items": [
                "Did",
                "you",
                "play",
                "football",
                "yesterday?"
              ],
              "explain": "Fragen im Simple Past: Did + Subjekt + Grundform + Rest."
            },
            {
              "id": "richtig-1",
              "type": "choice",
              "prompt": "Welcher Satz ist richtig?",
              "options": [
                "He didn't went home.",
                "He didn't go home.",
                "He don't went home.",
                "He not go home."
              ],
              "answer": 1,
              "explain": "Nach didn't steht die Grundform: He didn't go home."
            }
          ]
        }
      ]
    }
