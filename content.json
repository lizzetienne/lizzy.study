    {
      "id": "mathe",
      "name": "Mathe",
      "short": "Ma",
      "topics": [
        {
          "id": "lineare-funktionen",
          "name": "Lineare Funktionen",
          "summary": "Geraden, Steigung und y-Achsenabschnitt.",
          "theory": [
            {
              "type": "p",
              "text": "Eine **lineare Funktion** hat als Graphen eine Gerade. Man schreibt sie in der Form:"
            },
            {
              "type": "formula",
              "text": "y = m · x + b"
            },
            {
              "type": "list",
              "items": [
                "**m** ist die Steigung: Um so viel ändert sich y, wenn x um 1 größer wird.",
                "**b** ist der y-Achsenabschnitt: Dort schneidet die Gerade die y-Achse."
              ]
            },
            {
              "type": "h",
              "text": "Ausprobieren"
            },
            {
              "type": "linear-explorer"
            },
            {
              "type": "p",
              "text": "Verschiebe die Regler: **m** dreht die Gerade, **b** verschiebt sie nach oben oder unten."
            },
            {
              "type": "h",
              "text": "Steigung aus zwei Punkten"
            },
            {
              "type": "formula",
              "text": "m = (y₂ − y₁) / (x₂ − x₁)"
            },
            {
              "type": "example",
              "steps": [
                "Gegeben sind P(1 | 2) und Q(3 | 8).",
                "m = (8 − 2) / (3 − 1) = 6 / 2 = **3**",
                "Die Gerade steigt also um 3, wenn x um 1 größer wird."
              ]
            },
            {
              "type": "note",
              "text": "Ist m positiv, steigt die Gerade. Ist m negativ, fällt sie. Ist m = 0, verläuft sie waagerecht."
            }
          ],
          "tasks": [
            {
              "id": "graph-1",
              "type": "graph",
              "prompt": "Stelle die Gerade so ein, dass sie durch beide Punkte verläuft.",
              "m": 2,
              "b": -1,
              "points": [
                [
                  0,
                  -1
                ],
                [
                  2,
                  3
                ]
              ],
              "explain": "Die Gerade schneidet die y-Achse bei −1, also b = −1. Von x = 0 bis x = 2 steigt y um 4, also m = 4 / 2 = 2."
            },
            {
              "id": "steigung-1",
              "type": "input",
              "prompt": "Berechne die Steigung der Geraden durch P(1 | 2) und Q(3 | 8).",
              "answer": 3,
              "hint": "Nutze m = (y₂ − y₁) / (x₂ − x₁).",
              "explain": "m = (8 − 2) / (3 − 1) = 6 / 2 = 3"
            },
            {
              "id": "faellt-1",
              "type": "choice",
              "prompt": "Welche Gerade fällt?",
              "options": [
                "y = 2x + 5",
                "y = −0,5x + 3",
                "y = 4",
                "y = x − 7"
              ],
              "answer": 1,
              "explain": "Nur bei y = −0,5x + 3 ist die Steigung negativ. Deshalb fällt diese Gerade."
            },
            {
              "id": "eigenschaften-1",
              "type": "match",
              "prompt": "Ordne jeder Funktion ihre Eigenschaft zu.",
              "pairs": [
                [
                  "y = 3x",
                  "geht durch den Ursprung"
                ],
                [
                  "y = −x + 2",
                  "fällt"
                ],
                [
                  "y = 5",
                  "verläuft waagerecht"
                ],
                [
                  "y = 2x − 4",
                  "schneidet die y-Achse bei −4"
                ]
              ],
              "explain": "Ohne b geht die Gerade durch (0 | 0). Negatives m bedeutet fallend, m = 0 bedeutet waagerecht, und b ist der Schnittpunkt mit der y-Achse."
            },
            {
              "id": "einsetzen-1",
              "type": "input",
              "prompt": "Gegeben ist y = 2x + 3. Welchen Wert hat y für x = 4?",
              "answer": 11,
              "hint": "Setze 4 für x ein.",
              "explain": "y = 2 · 4 + 3 = 8 + 3 = 11"
            }
          ]
        },
        {
          "id": "pythagoras",
          "name": "Satz des Pythagoras",
          "summary": "Seitenlängen im rechtwinkligen Dreieck berechnen.",
          "theory": [
            {
              "type": "p",
              "text": "In jedem **rechtwinkligen Dreieck** gilt für die Seitenlängen:"
            },
            {
              "type": "formula",
              "text": "a² + b² = c²"
            },
            {
              "type": "list",
              "items": [
                "**a** und **b** sind die Katheten. Sie bilden den rechten Winkel.",
                "**c** ist die Hypotenuse. Sie liegt dem rechten Winkel gegenüber und ist immer die längste Seite."
              ]
            },
            {
              "type": "h",
              "text": "Hypotenuse berechnen"
            },
            {
              "type": "formula",
              "text": "c = √(a² + b²)"
            },
            {
              "type": "example",
              "steps": [
                "Gegeben: a = 6 cm, b = 8 cm",
                "c = √(6² + 8²) = √(36 + 64) = √100",
                "c = **10 cm**"
              ]
            },
            {
              "type": "h",
              "text": "Kathete berechnen"
            },
            {
              "type": "formula",
              "text": "a = √(c² − b²)"
            },
            {
              "type": "note",
              "text": "Prüfe immer zuerst, welche Seite die Hypotenuse ist. Suchst du eine Kathete, wird subtrahiert, suchst du die Hypotenuse, wird addiert."
            }
          ],
          "tasks": [
            {
              "id": "hypotenuse-1",
              "type": "input",
              "prompt": "Die Katheten sind a = 3 cm und b = 4 cm. Wie lang ist die Hypotenuse c?",
              "answer": 5,
              "unit": "cm",
              "hint": "c = √(a² + b²)",
              "explain": "c = √(9 + 16) = √25 = 5 cm"
            },
            {
              "id": "laengste-1",
              "type": "choice",
              "prompt": "Welche Seite ist im rechtwinkligen Dreieck immer am längsten?",
              "options": [
                "Die Kathete a",
                "Die Kathete b",
                "Die Hypotenuse c",
                "Das hängt vom Dreieck ab"
              ],
              "answer": 2,
              "explain": "Die Hypotenuse liegt dem rechten Winkel gegenüber und ist deshalb immer die längste Seite."
            },
            {
              "id": "kathete-1",
              "type": "input",
              "prompt": "Die Hypotenuse ist c = 13 cm, eine Kathete a = 5 cm. Wie lang ist b?",
              "answer": 12,
              "unit": "cm",
              "hint": "b = √(c² − a²)",
              "explain": "b = √(169 − 25) = √144 = 12 cm"
            },
            {
              "id": "schritte-1",
              "type": "order",
              "prompt": "Bringe die Rechenschritte in die richtige Reihenfolge (a = 6, b = 8).",
              "items": [
                "Formel aufschreiben: c² = a² + b²",
                "Werte einsetzen: c² = 6² + 8²",
                "Quadrieren: c² = 36 + 64",
                "Addieren: c² = 100",
                "Wurzel ziehen: c = 10"
              ],
              "explain": "Erst die Formel, dann einsetzen, ausrechnen und zum Schluss die Wurzel ziehen."
            }
          ]
        }
      ]
    },
    {
      "id": "deutsch",
      "name": "Deutsch",
      "short": "De",
      "topics": [
        {
          "id": "wortarten",
          "name": "Wortarten",
          "summary": "Nomen, Verben, Adjektive und Präpositionen erkennen.",
          "theory": [
            {
              "type": "p",
              "text": "Jedes Wort gehört zu einer **Wortart**. Die wichtigsten sind:"
            },
            {
              "type": "list",
              "items": [
                "**Nomen** bezeichnen Lebewesen, Dinge oder Gedanken und werden großgeschrieben: Haus, Freude, Lehrerin.",
                "**Verben** beschreiben, was jemand tut oder was passiert: laufen, denken, regnen.",
                "**Adjektive** beschreiben, wie etwas ist: schnell, freundlich, groß.",
                "**Präpositionen** zeigen Beziehungen, oft räumlich oder zeitlich: auf, unter, nach, während."
              ]
            },
            {
              "type": "h",
              "text": "Proben"
            },
            {
              "type": "example",
              "title": "So erkennst du die Wortart",
              "steps": [
                "**Artikelprobe:** Passt der, die oder das davor? Dann ist es ein Nomen.",
                "**Ich-Probe:** Kann man es mit ich verbinden (ich laufe)? Dann ist es ein Verb.",
                "**Wie-Probe:** Antwortet es auf die Frage Wie ist etwas? Dann ist es ein Adjektiv."
              ]
            },
            {
              "type": "note",
              "text": "Achtung: Auch Verben und Adjektive können zu Nomen werden, zum Beispiel beim Laufen oder das Gute."
            }
          ],
          "tasks": [
            {
              "id": "zuordnen-1",
              "type": "match",
              "prompt": "Ordne jedem Wort seine Wortart zu.",
              "pairs": [
                [
                  "Haus",
                  "Nomen"
                ],
                [
                  "laufen",
                  "Verb"
                ],
                [
                  "schnell",
                  "Adjektiv"
                ],
                [
                  "unter",
                  "Präposition"
                ]
              ],
              "explain": "Haus passt zur Artikelprobe, laufen zur Ich-Probe, schnell zur Wie-Probe, und unter zeigt eine räumliche Beziehung."
            },
            {
              "id": "luecken-1",
              "type": "gap",
              "prompt": "Ergänze ein Adjektiv, ein Verb und eine Präposition.",
              "text": "Der [kleine] Hund [rennt] [über] die Wiese.",
              "distractors": [
                "Baum",
                "Freude"
              ],
              "explain": "kleine beschreibt den Hund (Adjektiv), rennt ist die Tätigkeit (Verb), über zeigt die Richtung (Präposition)."
            },
            {
              "id": "adjektiv-1",
              "type": "choice",
              "prompt": "Welches Wort ist ein Adjektiv?",
              "options": [
                "Freude",
                "freundlich",
                "freuen",
                "Freund"
              ],
              "answer": 1,
              "explain": "freundlich beantwortet die Frage Wie ist jemand? Freude und Freund sind Nomen, freuen ist ein Verb."
            }
          ]
        }
      ]
    },
